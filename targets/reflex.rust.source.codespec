<|if(!is_defined(debug_spew_prefix))
<{  define(debug_spew_prefix)}"<{struct_name}:"<|end_define
<|end_if
// DO NOT MODIFY ! DO NOT MODIFY ! DO NOT MODIFY ! DO NOT MODIFY ! DO NOT MODIFY
// <{output_filename} generated by reflex<{if(is_defined(generate_timestamps))} at <{_creation_timestamp}<{end_if}
// from <{_source_filename} using <{_targetspec_filename} and <{_codespec_filename}
// DO NOT MODIFY ! DO NOT MODIFY ! DO NOT MODIFY ! DO NOT MODIFY ! DO NOT MODIFY

<|top_of_file?

#[derive(Clone, Copy, Debug, Eq, PartialEq)]
#[repr(usize)]
#[allow(non_camel_case_types)]
<{visibility} enum StateMachine {
<|for_each(key, _dfa_initial_node_index)
    <{key},
<|end_for_each
}

#[derive(Clone, Copy)]
struct DfaState {
    accept_handler: usize,
    transition_count: usize,
    transition_offset: usize,
}

#[derive(Clone, Copy)]
struct DfaTransition {
    target: usize,
    kind: u8,
    data_0: u8,
    data_1: u8,
}

const INPUT_ATOM: u8 = 0;
const INPUT_ATOM_RANGE: u8 = 1;
const CONDITIONAL: u8 = 2;
const CASE_INSENSITIVE: u8 = 1;
const UNGREEDY: u8 = 2;

const CF_BEGINNING_OF_INPUT: u8 = 1 << 0;
const CF_END_OF_INPUT: u8 = 1 << 1;
const CF_BEGINNING_OF_LINE: u8 = 1 << 2;
const CF_END_OF_LINE: u8 = 1 << 3;
const CF_WORD_BOUNDARY: u8 = 1 << 4;

<{visibility} struct <{struct_name} {
    input: Vec<u8>,
    cursor: usize,
    kept_start: usize,
    match_start: usize,
    current_state_machine: StateMachine,
    keep_next: bool,
<|if(is_defined(generate_debug_spew_code))
    debug_spew: bool,
<|end_if
<|extra_fields?
}

#[forbid(unsafe_code)]
impl <{struct_name} {
    <{visibility} fn new(input: impl Into<Vec<u8>><{if(is_defined(constructor_parameters))}, <{constructor_parameters}<{end_if}) -> Self {
        let mut scanner = Self {
            input: input.into(),
            cursor: 0,
            kept_start: 0,
            match_start: 0,
            current_state_machine: StateMachine::<{_start_with_state_machine},
            keep_next: false,
<|if(is_defined(generate_debug_spew_code))
            debug_spew: false,
<|end_if
<|extra_initializers?
        };
<|constructor_actions?
        scanner.reset_for_new_input();
        scanner
    }

    /// Adds bytes to the scanner's input.  This supports streaming callers
    /// without requiring a generated-code runtime or a reader lifetime.
    <{visibility} fn append(&mut self, input: impl AsRef<[u8]>) {
        self.input.extend_from_slice(input.as_ref());
    }

    <{visibility} fn replace_input(&mut self, input: impl Into<Vec<u8>>) {
        self.input = input.into();
        self.reset_for_new_input();
    }

    <{visibility} fn is_at_end_of_input(&self) -> bool {
        self.cursor >= self.input.len()
    }

    <{visibility} fn current_state_machine(&self) -> StateMachine {
        self.current_state_machine
    }

    <{visibility} fn switch_to_state_machine(&mut self, state_machine: StateMachine) {
        self.current_state_machine = state_machine;
<|if(is_defined(generate_debug_spew_code))
        if self.debug_spew {
            eprintln!("{} switching to state machine {:?}", <{debug_spew_prefix}, state_machine);
        }
<|end_if
    }

    <{visibility} fn reset_for_new_input(&mut self) {
        self.cursor = 0;
        self.kept_start = 0;
        self.match_start = 0;
        self.keep_next = false;
        self.current_state_machine = StateMachine::<{_start_with_state_machine};
<|reset_for_new_input_actions?
    }

<|if(is_defined(generate_debug_spew_code))
    <{visibility} fn debug_spew_is_enabled(&self) -> bool {
        self.debug_spew
    }

    <{visibility} fn set_debug_spew(&mut self, enabled: bool) {
        self.debug_spew = enabled;
    }

<|end_if
    /// Includes the current accepted bytes in the next accepted value, while
    /// beginning the next DFA match at the current cursor.
    <{visibility} fn keep_string(&mut self) {
        self.keep_next = true;
    }

    /// Returns the last `count` accepted bytes to the input stream.
    <{visibility} fn unaccept(&mut self, count: usize) {
        assert!(count <= self.cursor.saturating_sub(self.kept_start));
        self.cursor -= count;
        self.kept_start = self.cursor;
        self.keep_next = false;
    }

    /// Returns the last `count` rejected bytes to the input stream.
    <{visibility} fn unreject(&mut self, count: usize) {
        assert!(count <= self.cursor.saturating_sub(self.kept_start));
        self.cursor -= count;
        self.kept_start = self.cursor;
        self.keep_next = false;
    }

    #[allow(unreachable_code, unused_variables)]
    <{visibility} fn scan(&mut self<{if(is_defined(scan_method_parameters))}, <{scan_method_parameters}<{end_if}) -> <{return_type} {
<|top_of_scan_method_actions?
        loop {
            self.match_start = self.cursor;
            if !self.keep_next {
                self.kept_start = self.match_start;
            }
            self.keep_next = false;

            let was_at_end = self.is_at_end_of_input();
            match self.run_dfa() {
                Ok((handler, accept_end)) => {
                    self.cursor = accept_end;
                    let accepted_string = self.input[self.kept_start..accept_end].to_vec();
<|if(is_defined(generate_debug_spew_code))
                    if self.debug_spew {
                        eprintln!("{} accepting {:?} in {:?}", <{debug_spew_prefix}, String::from_utf8_lossy(&accepted_string), self.current_state_machine);
                    }
<|end_if
                    match handler {
<|loop(i, _accept_handler_count)
                        <{i} => {
<{_accept_handler_code[i]}
                        }
<|end_loop
                        _ => unreachable!("invalid accept-handler index"),
                    }
                    if self.keep_next {
                        // Preserve kept_start; the next DFA begins at cursor.
                    } else {
                        self.kept_start = self.cursor;
                    }
                }
                Err(reject_end) => {
                    if was_at_end {
                        break;
                    }
                    let rejected_start = self.kept_start;
                    self.cursor = reject_end;
                    let rejected_string = self.input[rejected_start..self.cursor].to_vec();
                    let rejected_atom = rejected_string.last().copied().unwrap_or(0);
<|if(is_defined(generate_debug_spew_code))
                    if self.debug_spew {
                        eprintln!("{} rejecting {:?} (atom {})", <{debug_spew_prefix}, String::from_utf8_lossy(&rejected_string), rejected_atom);
                    }
<|end_if
                    {
<{rejection_actions}
                    }
                    if !self.keep_next {
                        self.kept_start = self.cursor;
                    }
                }
            }
        }
<|bottom_of_scan_method_actions?
    }

    fn run_dfa(&self) -> Result<(usize, usize), usize> {
        let machine = self.current_state_machine as usize;
        let mut state_index = STATE_MACHINE_STARTS[machine];
        let mode = STATE_MACHINE_MODES[machine];
        let mut read_cursor = self.cursor;
        let mut accepted = None;

        loop {
            let state = STATES[state_index];
            if state.accept_handler < ACCEPT_HANDLER_COUNT {
                accepted = Some((state.accept_handler, read_cursor));
                if mode & UNGREEDY != 0 {
                    break;
                }
            }

            let flags = self.conditional_flags(read_cursor);
            let atom = self.input.get(read_cursor).copied().unwrap_or(0);
            let mut next = None;
            let transitions = &TRANSITIONS[state.transition_offset..state.transition_offset + state.transition_count];
            for transition in transitions {
                let matched = match transition.kind {
                    INPUT_ATOM => Self::atom_matches(atom, transition.data_0, transition.data_0, mode),
                    INPUT_ATOM_RANGE => Self::atom_matches(atom, transition.data_0, transition.data_1, mode),
                    CONDITIONAL => ((flags ^ transition.data_1) & transition.data_0) == 0,
                    _ => unreachable!("invalid DFA transition type"),
                };
                if matched {
                    next = Some((transition.target, transition.kind != CONDITIONAL));
                    break;
                }
            }

            match next {
                Some((target, consumes_atom)) => {
                    state_index = target;
                    if consumes_atom {
                        if read_cursor >= self.input.len() {
                            break;
                        }
                        read_cursor += 1;
                    }
                }
                None => break,
            }
        }
        match accepted {
            Some(value) => Ok(value),
            None => Err((read_cursor + 1).min(self.input.len())),
        }
    }

    fn atom_matches(atom: u8, low: u8, high: u8, mode: u8) -> bool {
        if (low..=high).contains(&atom) {
            return true;
        }
        mode & CASE_INSENSITIVE != 0 && (low..=high).contains(&Self::switch_ascii_case(atom))
    }

    fn switch_ascii_case(atom: u8) -> u8 {
        match atom {
            b'a'..=b'z' => atom - b'a' + b'A',
            b'A'..=b'Z' => atom - b'A' + b'a',
            _ => atom,
        }
    }

    fn conditional_flags(&self, cursor: usize) -> u8 {
        let previous = cursor.checked_sub(1).and_then(|i| self.input.get(i)).copied();
        let current = self.input.get(cursor).copied();
        let mut flags = 0;
        if previous.is_none() { flags |= CF_BEGINNING_OF_INPUT; }
        if current.is_none() { flags |= CF_END_OF_INPUT; }
        if previous.is_none() || previous == Some(b'\n') { flags |= CF_BEGINNING_OF_LINE; }
        if current.is_none() || current == Some(b'\n') { flags |= CF_END_OF_LINE; }
        if Self::is_word(previous) != Self::is_word(current) { flags |= CF_WORD_BOUNDARY; }
        flags
    }

    fn is_word(atom: Option<u8>) -> bool {
        matches!(atom, Some(b'a'..=b'z' | b'A'..=b'Z' | b'0'..=b'9' | b'_'))
    }

<|extra_impl_items?
}

const STATE_MACHINE_STARTS: &[usize] = &[
<|for_each(key, _state_machine_mode_flags)
    <{_dfa_initial_node_index[key]},
<|end_for_each
];

const STATE_MACHINE_MODES: &[u8] = &[
<|for_each(key, _state_machine_mode_flags)
    <{_state_machine_mode_flags[key]},
<|end_for_each
];

const ACCEPT_HANDLER_COUNT: usize = <{_accept_handler_count};

const STATES: &[DfaState] = &[
<|loop(i, _dfa_state_count)
    DfaState { accept_handler: <{_dfa_state_accept_handler_index[i]}, transition_count: <{_dfa_state_transition_count[i]}, transition_offset: <{_dfa_state_transition_offset[i]} },
<|end_loop
];

const TRANSITIONS: &[DfaTransition] = &[
<|loop(i, _dfa_transition_count)
    DfaTransition { target: <{_dfa_transition_target_node_index[i]}, kind: <{_dfa_transition_type_integer[i]}, data_0: <{_dfa_transition_data_0[i]}, data_1: <{_dfa_transition_data_1[i]} },
<|end_loop
];

<|bottom_of_file?
