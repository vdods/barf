#[allow(non_camel_case_types)]
#[derive(Clone, Copy, Debug, Eq, PartialEq)]
#[repr(u32)]
<{visibility} enum Terminal {
<|loop(i, sizeof(_terminal_name_list))
    <{_terminal_name_list[i]} = <{_terminal_index_list[i]},
<|end_loop
}

#[allow(non_camel_case_types)]
#[derive(Clone, Copy, Debug, Eq, PartialEq)]
#[repr(u32)]
<{visibility} enum Nonterminal {
<|loop(i, sizeof(_nonterminal_name_list))
    <{_nonterminal_name_list[i]} = <{_nonterminal_index_list[i]},
<|end_loop
}

#[derive(Debug)]
<{visibility} struct Token {
    <{visibility} id: u32,
    <{visibility} data: Option<<{token_data_type}>,
}

impl Token {
    <{visibility} fn new(id: u32, data: <{token_data_type}) -> Self {
        Self { id, data: Some(data) }
    }

    <{visibility} fn without_data(id: u32) -> Self {
        Self { id, data: Some(<{token_data_default}) }
    }
}

#[derive(Clone, Copy, Debug, Eq, PartialEq)]
<{visibility} enum ParseError {
    UnexpectedToken { position: usize, token_id: u32 },
    ConfigurationLimitExceeded,
    InvalidGeneratedParser,
}

#[derive(Clone, Copy)]
struct State {
    transition_count: usize,
    transition_offset: usize,
}

#[derive(Clone, Copy)]
struct Transition {
    kind: u8,
    token: u32,
    data: u32,
}

#[derive(Clone, Copy)]
struct Rule {
    lhs: u32,
    token_count: usize,
    precedence: usize,
}

#[derive(Clone, Copy)]
struct Precedence {
    level: i32,
    associativity: u8,
}

const RETURN: u8 = 1;
const ABORT: u8 = 2;
const REDUCE: u8 = 3;
const SHIFT: u8 = 4;
const INSERT_LOOKAHEAD_ERROR: u8 = 5;
const DISCARD_LOOKAHEAD: u8 = 6;
const POP_STACK: u8 = 7;
const EPSILON: u8 = 8;
const ASSOC_LEFT: u8 = 0;
const ASSOC_NONASSOC: u8 = 1;
const ASSOC_RIGHT: u8 = 2;
const NO_RULE: u32 = u32::MAX;

#[derive(Clone, Copy)]
enum Action {
    Shift,
    Reduce(usize),
    InsertError,
    DiscardLookahead,
    PopStack(usize),
}

#[derive(Clone)]
struct Configuration {
    states: Vec<usize>,
    symbols: Vec<u32>,
    input: usize,
    error_lookahead: bool,
    actions: Vec<Action>,
}

<{visibility} struct <{struct_name} {
    had_error: bool,
}

#[forbid(unsafe_code)]
impl <{struct_name} {
    <{visibility} fn new() -> Self {
        Self { had_error: false }
    }

    /// Returns whether the most recent parse recovered from an error.
    <{visibility} fn has_encountered_error_state(&self) -> bool {
        self.had_error
    }

    /// Parses one nonterminal from an owned token stream. Recognition is done
    /// using token ids only; semantic actions run once, after a path is chosen.
    <{visibility} fn parse(
        &mut self,
        tokens: impl IntoIterator<Item = Token>,
        nonterminal: Nonterminal,
    ) -> Result<<{token_data_type}, ParseError> {
        self.had_error = false;
        let mut input: Vec<Token> = tokens.into_iter().collect();
        let start = Self::nonterminal_start_state(nonterminal);
        let plan = self.recognize(&input, start)?;
        self.execute_plan(&mut input, &plan)
    }

    fn recognize(&self, input: &[Token], start: usize) -> Result<Vec<Action>, ParseError> {
        let mut pending = vec![Configuration { states: vec![start], symbols: Vec::new(), input: 0, error_lookahead: false, actions: Vec::new() }];
        let mut visited: std::collections::HashSet<(Vec<usize>, Vec<u32>, usize, bool)> = std::collections::HashSet::new();
        let mut examined = 0usize;
        let mut furthest_input = 0usize;

        while let Some(configuration) = pending.pop() {
            furthest_input = furthest_input.max(configuration.input);
            examined += 1;
            if examined > <{max_parser_configurations} {
                return Err(ParseError::ConfigurationLimitExceeded);
            }
            if !visited.insert((configuration.states.clone(), configuration.symbols.clone(), configuration.input, configuration.error_lookahead)) {
                continue;
            }

            let state = *configuration.states.last().ok_or(ParseError::InvalidGeneratedParser)?;
            let lookahead = if configuration.error_lookahead {
                Some(Terminal::ERROR_ as u32)
            } else {
                input.get(configuration.input).map(|token| token.id)
            };
            let transitions = Self::non_epsilon_transitions(state);
            if transitions.iter().any(|transition| transition.kind == RETURN) {
                return Ok(configuration.actions);
            }

            let mut reductions: Vec<Transition> = transitions.iter().copied()
                .filter(|transition| transition.kind == REDUCE && (transition.token == 0 || Some(transition.token) == lookahead))
                .collect();
            let mut shifts: Vec<Transition> = transitions.iter().copied()
                .filter(|transition| transition.kind == SHIFT && Some(transition.token) == lookahead)
                .collect();
            Self::resolve_shift_reduce_conflicts(&mut reductions, &mut shifts);

            // Recovery transitions are explored after ordinary parsing paths.
            // This preserves valid parses while allowing a recovery production
            // to proceed when all normal paths fail.
            if !configuration.error_lookahead {
                if transitions.iter().any(|transition| {
                    transition.kind == INSERT_LOOKAHEAD_ERROR
                        && (transition.token == 0 || Some(transition.token) == lookahead)
                }) {
                    let mut next = configuration.clone();
                    next.error_lookahead = true;
                    next.actions.push(Action::InsertError);
                    pending.push(next);
                }
            }
            if configuration.symbols.last() == Some(&(Terminal::ERROR_ as u32)) {
                if transitions.iter().any(|transition| {
                    transition.kind == DISCARD_LOOKAHEAD
                        && !configuration.error_lookahead
                        && (transition.token == 0 || Some(transition.token) == lookahead)
                }) {
                    let mut next = configuration.clone();
                    next.input += 1;
                    next.actions.push(Action::DiscardLookahead);
                    pending.push(next);
                }
            }
            for transition in transitions.iter().filter(|transition| {
                transition.kind == POP_STACK
                    && Some(transition.token) == lookahead
                    && (transition.data == 1 || transition.data == 2)
                    && transition.data as usize <= configuration.symbols.len()
            }) {
                let pop_count = transition.data as usize;
                let mut next = configuration.clone();
                next.states.truncate(next.states.len() - pop_count);
                next.symbols.truncate(next.symbols.len() - pop_count);
                next.error_lookahead = true;
                next.actions.push(Action::PopStack(pop_count));
                pending.push(next);
            }

            // pending is a stack. Push lower-priority paths first so higher
            // precedence and lower rule indices are explored first.
            reductions.sort_by_key(|transition| std::cmp::Reverse(Self::rule_priority(transition.data as usize)));
            for transition in reductions.into_iter().rev() {
                let rule_index = transition.data as usize;
                let rule = RULES[rule_index];
                if rule.token_count >= configuration.states.len() {
                    continue;
                }
                let mut base_states = configuration.states.clone();
                base_states.truncate(base_states.len() - rule.token_count);
                let goto_source = *base_states.last().ok_or(ParseError::InvalidGeneratedParser)?;
                for goto in Self::non_epsilon_transitions(goto_source).into_iter().filter(|candidate| candidate.kind == SHIFT && candidate.token == rule.lhs) {
                    let mut next = configuration.clone();
                    next.states = base_states.clone();
                    next.states.push(goto.data as usize);
                    next.symbols.truncate(next.symbols.len() - rule.token_count);
                    next.symbols.push(rule.lhs);
                    next.actions.push(Action::Reduce(rule_index));
                    pending.push(next);
                }
            }
            for transition in shifts.into_iter().rev() {
                let mut next = configuration.clone();
                next.states.push(transition.data as usize);
                next.symbols.push(transition.token);
                if next.error_lookahead {
                    next.error_lookahead = false;
                } else {
                    next.input += 1;
                }
                next.actions.push(Action::Shift);
                pending.push(next);
            }
        }

        let position = furthest_input.min(input.len());
        let token_id = input.get(position).map(|token| token.id).unwrap_or(Terminal::END_ as u32);
        Err(ParseError::UnexpectedToken { position, token_id })
    }

    fn non_epsilon_transitions(state: usize) -> Vec<Transition> {
        let mut output = Vec::new();
        let mut pending = vec![state];
        let mut visited = std::collections::HashSet::new();
        while let Some(index) = pending.pop() {
            if !visited.insert(index) { continue; }
            let state = STATES[index];
            for transition in &TRANSITIONS[state.transition_offset..state.transition_offset + state.transition_count] {
                if transition.kind == EPSILON {
                    pending.push(transition.data as usize);
                } else if !output.iter().any(|existing: &Transition| existing.kind == transition.kind && existing.token == transition.token && existing.data == transition.data) {
                    output.push(*transition);
                }
            }
        }
        output
    }

    fn resolve_shift_reduce_conflicts(reductions: &mut Vec<Transition>, shifts: &mut Vec<Transition>) {
        if reductions.is_empty() || shifts.is_empty() { return; }
        let best_reduce = reductions.iter().map(|transition| Self::rule_priority(transition.data as usize)).max().unwrap();
        let best_shift = shifts.iter().map(|transition| {
            let rule = STATE_RULES[transition.data as usize];
            if rule == NO_RULE { (0, std::cmp::Reverse(usize::MAX)) } else { Self::rule_priority(rule as usize) }
        }).max().unwrap();
        if best_reduce.0 > best_shift.0 {
            shifts.clear();
        } else if best_shift.0 > best_reduce.0 {
            reductions.clear();
        } else if best_reduce.0 > 0 {
            match PRECEDENCES[RULES[reductions[0].data as usize].precedence].associativity {
                ASSOC_LEFT => shifts.clear(),
                ASSOC_RIGHT => reductions.clear(),
                ASSOC_NONASSOC => { reductions.clear(); shifts.clear(); }
                _ => {}
            }
        }
    }

    fn rule_priority(rule: usize) -> (i32, std::cmp::Reverse<usize>) {
        (PRECEDENCES[RULES[rule].precedence].level, std::cmp::Reverse(rule))
    }

    fn execute_plan(&mut self, input: &mut [Token], plan: &[Action]) -> Result<<{token_data_type}, ParseError> {
        let mut stack: Vec<Token> = Vec::new();
        let mut cursor = 0usize;
        let mut error_lookahead = false;
        for action in plan {
            match *action {
                Action::Shift => {
                    if error_lookahead {
                        stack.push(Token::without_data(Terminal::ERROR_ as u32));
                        error_lookahead = false;
                    } else {
                        let token = input.get_mut(cursor).ok_or(ParseError::InvalidGeneratedParser)?;
                        stack.push(Token { id: token.id, data: token.data.take() });
                        cursor += 1;
                    }
                }
                Action::Reduce(rule_index) => {
                    let rule = RULES[rule_index];
                    if rule.token_count > stack.len() { return Err(ParseError::InvalidGeneratedParser); }
                    let split = stack.len() - rule.token_count;
                    let mut reduced = stack.split_off(split);
                    let error_token = Token::without_data(Terminal::ERROR_ as u32);
                    let lookahead = if error_lookahead { Some(&error_token) } else { input.get(cursor) };
                    let reduced_data = self.execute_reduction(rule_index, &mut reduced, lookahead)?;
                    stack.push(Token::new(rule.lhs, reduced_data));
                }
                Action::InsertError => {
                    self.had_error = true;
                    error_lookahead = true;
                }
                Action::DiscardLookahead => {
                    self.had_error = true;
                    if stack.last().map(|token| token.id) != Some(Terminal::ERROR_ as u32) {
                        return Err(ParseError::InvalidGeneratedParser);
                    }
                    let error_token = stack.last_mut().ok_or(ParseError::InvalidGeneratedParser)?;
                    error_token.data = Some(<{token_data_default});
                    cursor += 1;
                }
                Action::PopStack(pop_count) => {
                    self.had_error = true;
                    if pop_count > stack.len() { return Err(ParseError::InvalidGeneratedParser); }
                    stack.truncate(stack.len() - pop_count);
                    error_lookahead = true;
                }
            }
        }
        if stack.len() != 1 { return Err(ParseError::InvalidGeneratedParser); }
        stack.pop().and_then(|mut token| token.data.take()).ok_or(ParseError::InvalidGeneratedParser)
    }

    #[allow(unused_variables, unreachable_code, unused_braces)]
    fn execute_reduction(&mut self, rule_index: usize, reduced: &mut [Token], lookahead: Option<&Token>) -> Result<<{token_data_type}, ParseError> {
        let value = match rule_index {
<|loop(i, _rule_count)
            <{i} => {
<|loop(j, _rule_token_table_count[i])
<|if(_rule_token_assigned_id[_rule_token_table_offset[i]+j] != "")
                let <{_rule_token_assigned_id[_rule_token_table_offset[i]+j]}: <{token_data_type} = reduced[<{j}].data.take().ok_or(ParseError::InvalidGeneratedParser)?;
<|end_if
<|end_loop
<|if(_rule_lookahead_assigned_id[i] != "")
                let <{_rule_lookahead_assigned_id[i]} = lookahead.ok_or(ParseError::InvalidGeneratedParser)?;
<|end_if
                { <{_rule_code[i]} }
            }
<|end_loop
            _ => return Err(ParseError::InvalidGeneratedParser),
        };
        Ok(value)
    }

    fn nonterminal_start_state(nonterminal: Nonterminal) -> usize {
        match nonterminal {
<|for_each(key, _npda_nonterminal_start_state_index)
            Nonterminal::<{key} => <{_npda_nonterminal_start_state_index[key]},
<|end_for_each
            _ => 0,
        }
    }

<|extra_impl_items?
}

const PRECEDENCES: &[Precedence] = &[
<|loop(i, _precedence_count)
    Precedence { level: <{_precedence_level[i]}, associativity: <{_precedence_associativity_index[i]} },
<|end_loop
];

const RULES: &[Rule] = &[
<|loop(i, _rule_count)
    Rule { lhs: Nonterminal::<{_rule_reduction_nonterminal_name[i]} as u32, token_count: <{_rule_token_count[i]}, precedence: <{_rule_precedence_index[i]} },
<|end_loop
];

const STATES: &[State] = &[
<|loop(i, _npda_state_count)
    State { transition_count: <{_npda_state_transition_count[i]}, transition_offset: <{_npda_state_transition_offset[i]} },
<|end_loop
];

const STATE_RULES: &[u32] = &[
<|loop(i, _npda_state_count)
    <{_npda_state_rule_index[i]},
<|end_loop
];

const TRANSITIONS: &[Transition] = &[
<|loop(i, _npda_transition_count)
    Transition { kind: <{if(_npda_transition_type_name[i] == "RETURN")}RETURN<{else_if(_npda_transition_type_name[i] == "ABORT")}ABORT<{else_if(_npda_transition_type_name[i] == "REDUCE")}REDUCE<{else_if(_npda_transition_type_name[i] == "SHIFT")}SHIFT<{else_if(_npda_transition_type_name[i] == "INSERT_LOOKAHEAD_ERROR")}INSERT_LOOKAHEAD_ERROR<{else_if(_npda_transition_type_name[i] == "DISCARD_LOOKAHEAD")}DISCARD_LOOKAHEAD<{else_if(_npda_transition_type_name[i] == "POP_STACK")}POP_STACK<{else_if(_npda_transition_type_name[i] == "EPSILON")}EPSILON<{else}0<{end_if}, token: <{_npda_transition_token_index[i]}, data: <{if(_npda_transition_data_index[i] < 0)}u32::MAX<{else}<{_npda_transition_data_index[i]}<{end_if} },
<|end_loop
];

<|bottom_of_file?
